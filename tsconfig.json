{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"],
  "exclude": [
    "**/dist/**",
    "**/dist-frontend/**",
    "**/node_modules/**",
    "apps/desktop/frontend",
    "apps/desktop/vite.config.ts"
  ]
}
