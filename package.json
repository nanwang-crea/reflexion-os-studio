{
  "name": "@reflexion-os-studio/workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @reflexion-os-studio/desktop dev",
    "browser:prepare": "node scripts/prepare-browser.mjs --dev",
    "dev:runtime": "bash scripts/dev-runtime.sh",
    "build": "bash scripts/build-all.sh",
    "build:desktop": "pnpm --filter @reflexion-os-studio/desktop build",
    "dev:desktop": "pnpm --filter @reflexion-os-studio/desktop dev",
    "build:packages": "bash scripts/build-ts.sh",
    "build:system": "cargo build --manifest-path crates/Cargo.toml",
    "generate:runtime-methods": "node scripts/generate-runtime-methods.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "bash scripts/test-all.sh",
    "test:ts": "tsc --noEmit",
    "clean": "rm -rf apps/*/dist apps/*/dist-frontend packages/*/dist",
    "prepare:cef": "node scripts/native/prepare-cef.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  },
  "pnpm": {
    "patchedDependencies": {
      "playwright-core@1.64.0-alpha-1790635538000": "patches/playwright-core@1.64.0-alpha-1790635538000.patch"
    }
  }
}
