{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReflexionOS Studio",
  "version": "0.1.0",
  "identifier": "com.reflexionos.studio",
  "build": {
    "beforeDevCommand": "pnpm -w build:system && pnpm dev:frontend",
    "beforeBuildCommand": "pnpm prepare:package && pnpm build:frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist-frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReflexionOS Studio",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: blob: http://asset.localhost; media-src 'self' data: blob:; object-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": {
      "package-resources/": "pkg"
    }
  }
}
